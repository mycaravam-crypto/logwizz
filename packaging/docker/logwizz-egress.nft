# OPTIONAL, standalone Docker egress policy. Review interface and allowed destinations.
# Never flush the full ruleset: Docker owns its own firewall rules.
# Apply only after the bridge interface exists. Uninstall: nft delete table inet logwizz_egress
table inet logwizz_egress {
    set https_v4 {
        type ipv4_addr
        flags interval
        # Replace this documentation-only address with the APIs your service needs.
        elements = { 192.0.2.10 }
    }

    chain forward {
        type filter hook forward priority -50; policy accept;

        # Scope every rule to this dedicated Docker bridge; do not affect other networks.
        # Existing connections can continue; this profile gates NEW outbound flows.
        iifname "br-logwizz" ct state established,related accept
        iifname "br-logwizz" ip daddr @https_v4 tcp dport 443 accept

        # Rate limiting caps log volume, NOT blocking; IPv6 and non-TCP are denied too.
        iifname "br-logwizz" limit rate 5/second burst 10 packets log prefix "logwizz-egress-deny: " level warn
        iifname "br-logwizz" counter drop
    }
}
