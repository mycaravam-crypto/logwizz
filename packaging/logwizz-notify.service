# systemd unit for logwizz-notify: aggregates detections and sends summaries to Telegram, ntfy or a webhook.
#
# Needs logwizz.service with format = "json" and syslog_prefix = true, and
# curl installed. Install the binary as /usr/bin/logwizz-notify and the
# settings as /etc/logwizz/notify.env (mode 0600, see notify.env.example), then:
#   systemctl daemon-reload && systemctl enable --now logwizz-notify
#
# logwizz itself has no network access; this unit is the only part that does.

[Unit]
Description=logwizz aggregated detection notifications
Documentation=https://github.com/mycaravam-crypto/logwizz
After=logwizz.service network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/logwizz/notify.env
ExecStart=/usr/bin/logwizz-notify
Restart=on-failure
RestartSec=10s
# On stop, pending summaries are sent for up to 30 s, plus one delivery in
# progress (curl retries for up to about 45 s); the rest stay on disk.
TimeoutStopSec=90s

# Identity: reads the journal through systemd-journal, nothing else.
DynamicUser=yes
SupplementaryGroups=systemd-journal
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Filesystem: read-only except the state file with the journal cursor and
# pending summaries (StateDirectory). Secrets are passed to curl on its
# standard input and never written to disk.
StateDirectory=logwizz-notify
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
# No ProcSubset=pid: journalctl reads /proc/sys/kernel/random/boot_id.

# Kernel and system interfaces
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes

# Network: outbound HTTPS to Telegram or the configured notification endpoint.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
