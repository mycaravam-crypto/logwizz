# /etc/logwizz/notify.env: settings for logwizz-notify.service.
# Install with mode 0600 (it may hold a token); systemd reads it as root.

# Where to send events.
NOTIFY_URL=https://ntfy.sh/my-secret-topic
# "webhook": POST the event as JSON (Content-Type: application/json).
# "ntfy":    POST the line as the message, with Title, Priority and Tags set
#            from the event (ntfy.sh, or a self-hosted ntfy server).
NOTIFY_KIND=ntfy
# Lowest severity that is forwarded: debug, info, notice, warning, error, crit.
NOTIFY_MIN_PRIORITY=warning
# Optional success logging. Set to yes to log each delivered rule to the journal.
# Keep no for high-volume deployments to avoid noisy service logs.
NOTIFY_LOG_SUCCESS=no
# Optional value of the Authorization header, e.g. "Bearer tk_..." for ntfy
# access tokens.
#NOTIFY_AUTH=
