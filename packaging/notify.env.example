# /etc/logwizz/notify.env: settings for logwizz-notify.service.
# Install with mode 0600. Telegram bot tokens and optional auth headers are secrets.

# Preferred first channel. Create a bot with @BotFather and set the target chat ID.
NOTIFY_KIND=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Aggregation window in seconds (10..3600; default 60).
NOTIFY_WINDOW_SECS=60
# Maximum pending rule/window summaries before the notifier stops consuming new entries.
NOTIFY_MAX_PENDING=4096
# Lowest event severity forwarded: debug, info, notice, warning, error, critical.
NOTIFY_MIN_PRIORITY=warning

# Optional alternate transports. They receive the aggregate summary, never raw log lines.
#NOTIFY_KIND=ntfy
#NOTIFY_URL=https://ntfy.sh/my-secret-topic
#NOTIFY_AUTH=Bearer tk_...

#NOTIFY_KIND=webhook
#NOTIFY_URL=https://example.invalid/logwizz
#NOTIFY_AUTH=Bearer token
