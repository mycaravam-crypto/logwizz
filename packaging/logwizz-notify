#!/bin/sh
# logwizz-notify: forwards logwizz events from the journal to a webhook or ntfy.
#
# Reads the logwizz journal namespace from where it stopped (cursor in
# $STATE_DIRECTORY), keeps events at or above NOTIFY_MIN_PRIORITY, and POSTs
# each one. Needs logwizz with format = "json" and syslog_prefix = true, plus
# curl and jq. Configuration comes from the environment, see notify.env.example.
set -u

: "${NOTIFY_URL:?NOTIFY_URL is not set}"
kind=${NOTIFY_KIND:-webhook}
min=${NOTIFY_MIN_PRIORITY:-warning}
[ "$min" = critical ] && min=crit # journalctl spells it crit
state=${STATE_DIRECTORY:-/var/lib/logwizz-notify}
cursor=$state/cursor
log_success=${NOTIFY_LOG_SUCCESS:-no}
case $kind in
  webhook | ntfy) ;;
  *) echo "logwizz-notify: NOTIFY_KIND must be webhook or ntfy, not '$kind'" >&2; exit 2 ;;
esac
case $log_success in
  yes | no) ;;
  *) echo "logwizz-notify: NOTIFY_LOG_SUCCESS must be yes or no, not '$log_success'" >&2; exit 2 ;;
esac
for cmd in journalctl curl jq; do
  command -v "$cmd" >/dev/null || { echo "logwizz-notify: $cmd not found" >&2; exit 2; }
done

# The token goes to curl through a file, never on its command line.
auth=
if [ -n "${NOTIFY_AUTH:-}" ]; then
  auth=${RUNTIME_DIRECTORY:-$state}/auth-header
  (umask 077 && printf 'Authorization: %s\n' "$NOTIFY_AUTH" > "$auth")
fi

post() { # body [curl options...]
  body=$1; shift
  # -H @file reads the header from the file (curl >= 7.55).
  curl -fsS -o /dev/null --max-time 10 --retry 5 --retry-all-errors \
    ${auth:+-H "@$auth"} "$@" --data-binary "$body" "$NOTIFY_URL"
}

send() { # event JSON
  if [ "$kind" = webhook ]; then
    post "$1" -H 'Content-Type: application/json'
    return
  fi
  # Each value is quoted for the shell by @sh, so eval only assigns.
  host='' rule='' sev='' desc='' line=''
  eval "$(printf '%s' "$1" | jq -r '"host=\(.host | @sh) rule=\(.rule | @sh) sev=\(.severity | @sh) desc=\(.description | @sh) line=\(.line | @sh)"')" || return
  case $sev in
    critical) prio=5 ;; error | warning) prio=4 ;; notice) prio=3 ;; info) prio=2 ;; *) prio=1 ;;
  esac
  post "${desc:+$desc
}$line" -H "Title: logwizz $host: $rule" -H "Priority: $prio" -H "Tags: $sev"
}

if [ -s "$cursor" ]; then
  from="--after-cursor=$(cat "$cursor")"
else
  from=--lines=0 # first start: only events from now on
fi

journalctl --namespace=logwizz -u logwizz -p "$min" -f -o json "$from" |
  while IFS= read -r entry; do
    c=$(printf '%s' "$entry" | jq -er .__CURSOR) || continue # -e: no cursor, no save
    ev=$(printf '%s' "$entry" | jq -r '.MESSAGE | strings')
    case $ev in
      '{'*)
        rule=$(printf '%s' "$ev" | jq -r '.rule // "unknown" | tostring')
        if send "$ev"; then
          if [ "$log_success" = yes ]; then
            echo "logwizz-notify: delivered event for rule '$rule'" >&2
          fi
        else
          echo "logwizz-notify: delivery failed for rule '$rule'; cursor unchanged, stopping for retry" >&2
          exit 1
        fi
        ;;
      *) ;; # logwizz's own diagnostics, not events
    esac
    # Persist only after delivery (or after deliberately ignoring a non-event).
    # If persistence fails, exit so the event is replayed after restart.
    if ! { printf '%s\n' "$c" > "$cursor.tmp" && mv "$cursor.tmp" "$cursor"; }; then
      echo "logwizz-notify: failed to persist journal cursor; stopping (event may be redelivered)" >&2
      exit 1
    fi
  done
echo "logwizz-notify: journalctl exited" >&2
exit 1
