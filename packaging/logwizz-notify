#!/usr/bin/env bash
set -uo pipefail
umask 077
kind=${NOTIFY_KIND:-telegram}
min=${NOTIFY_MIN_PRIORITY:-warning}
window=${NOTIFY_WINDOW_SECS:-60}
max_pending=${NOTIFY_MAX_PENDING:-4096}
state=${STATE_DIRECTORY:-/var/lib/logwizz-notify}
runtime=${RUNTIME_DIRECTORY:-/run/logwizz-notify}
cursor_file=$state/cursor
auth_file=
endpoint_config=
telegram_config=
latest_bucket=0
die() { echo "logwizz-notify: $*" >&2; exit 2; }
log() { echo "logwizz-notify: $*" >&2; }
[[ $min == critical ]] && min=crit
if [[ ! $window =~ ^[0-9]+$ ]]; then die "NOTIFY_WINDOW_SECS must be an integer"; fi
if (( window < 10 || window > 3600 )); then die "NOTIFY_WINDOW_SECS must be 10..3600"; fi
if [[ ! $max_pending =~ ^[0-9]+$ ]]; then die "NOTIFY_MAX_PENDING must be an integer"; fi
if (( max_pending < 1 || max_pending > 65536 )); then die "NOTIFY_MAX_PENDING must be 1..65536"; fi
case $kind in
telegram) [[ -n ${TELEGRAM_BOT_TOKEN:-} ]] || die "TELEGRAM_BOT_TOKEN is not set"; [[ ${TELEGRAM_BOT_TOKEN} =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]] || die "TELEGRAM_BOT_TOKEN has invalid format"; [[ -n ${TELEGRAM_CHAT_ID:-} ]] || die "TELEGRAM_CHAT_ID is not set" ;;
webhook|ntfy) [[ -n ${NOTIFY_URL:-} ]] || die "NOTIFY_URL is not set"; [[ $NOTIFY_URL == https://* ]] || die "NOTIFY_URL must use HTTPS" ;;
*) die "NOTIFY_KIND must be telegram, ntfy or webhook" ;;
esac
for cmd in journalctl curl jq date sha256sum find wc tr; do command -v "$cmd" >/dev/null || die "$cmd not found"; done
mkdir -p "$state" "$runtime" || die "cannot create state/runtime directory"
chmod 0700 "$state" "$runtime" 2>/dev/null || true
if [[ $kind == webhook || $kind == ntfy ]]; then endpoint_config=$runtime/endpoint-curl.conf; printf 'url = "%s"\n' "${NOTIFY_URL}" > "$endpoint_config" || die "cannot write endpoint curl config"; chmod 0600 "$endpoint_config"; fi
if [[ -n ${NOTIFY_AUTH:-} ]]; then auth_file=$runtime/auth-header; printf 'Authorization: %s\n' "${NOTIFY_AUTH}" > "$auth_file" || die "cannot write auth header"; chmod 0600 "$auth_file"; fi
if [[ $kind == telegram ]]; then telegram_config=$runtime/telegram-curl.conf; printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "${TELEGRAM_BOT_TOKEN}" > "$telegram_config" || die "cannot write Telegram curl config"; chmod 0600 "$telegram_config"; fi
curl_opts=(--silent --show-error --fail --max-time 10 --retry 3 --retry-all-errors --retry-delay 1)
[[ -n $auth_file ]] && curl_opts+=(--header "@$auth_file")
save_cursor() { local value=$1 tmp="$cursor_file.tmp.$$"; printf '%s\n' "$value" > "$tmp" && mv -f "$tmp" "$cursor_file"; }
pending_count() { find "$state" -maxdepth 1 -type f -name 'agg-*.json' -print | wc -l | tr -d ' '; }
send_summary() {
local file=$1 partial=$2 summary message host rule severity priority response
summary=$(jq -c --argjson partial "$partial" 'del(.bucket,.last_cursor,.source_seen,.retry_count,.retry_after) | .schema="logwizz.notification/v1" | .partial=$partial' "$file") || return 1
host=$(jq -r '.host' "$file"); rule=$(jq -r '.rule' "$file"); severity=$(jq -r '.severity' "$file")
message=$(jq -r --argjson partial "$partial" 'def clean: tostring | gsub("[\\r\\n]"; " "); "logwizz alert - " + (.host | clean) + "\nRule: " + (.rule | clean) + (if (.description // "") != "" then "\nDescription: " + (.description | clean) else "" end) + "\nSeverity: " + (.severity | clean) + "\nMatches: " + (.count | tostring) + "\nWindow: " + .window_start + " - " + .window_end + (if (.source // "") != "" then "\nSource: " + (.source | clean) else "" end) + (if $partial then "\nPartial window (shutdown or delayed delivery)" else "" end)' "$file") || return 1
case $kind in
webhook) curl "${curl_opts[@]}" --config "$endpoint_config" -H 'Content-Type: application/json' --data-binary "$summary" >/dev/null ;;
ntfy) case $severity in critical) priority=5 ;; error|warning) priority=4 ;; notice) priority=3 ;; info) priority=2 ;; *) priority=1 ;; esac; curl "${curl_opts[@]}" --config "$endpoint_config" -H "Title: logwizz $host: $rule" -H "Priority: $priority" -H "Tags: $severity" --data-binary "$message" >/dev/null ;;
telegram) response=$(curl "${curl_opts[@]}" --config "$telegram_config" --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" --data-urlencode "text=$message" --data-urlencode "disable_web_page_preview=true") || return 1; printf '%s' "$response" | jq -e '.ok == true' >/dev/null || return 1 ;;
esac
}
flush_file() {
  local file=$1 partial=$2 count delay retry_after tmp
  if send_summary "$file" "$partial"; then rm -f -- "$file"; return 0; fi
  count=$(jq -r '.retry_count // 0' "$file" 2>/dev/null) || count=0
  if (( count > 7 )); then delay=300; else delay=$(( 2 ** (count + 1) )); (( delay > 300 )) && delay=300; fi
  retry_after=$(( $(date -u +%s) + delay ))
  tmp="$file.tmp.$$"
  if jq --argjson count "$((count + 1))" --argjson retry_after "$retry_after" '.retry_count=$count | .retry_after=$retry_after' "$file" > "$tmp"; then mv -f "$tmp" "$file"; else rm -f "$tmp"; fi
  log "delivery failed; summary retained for retry in about ${delay}s"
  return 1
}
flush_due() { local now file bucket retry_after failed=0; now=$(date -u +%s); for file in "$state"/agg-*.json; do [[ -f $file ]] || continue; bucket=$(jq -er '.bucket' "$file") || { log "invalid aggregate state"; failed=1; continue; }; retry_after=$(jq -r '.retry_after // 0' "$file") || retry_after=0
    if (( bucket + window <= now && retry_after <= now )); then flush_file "$file" false || failed=1; fi; done; return "$failed"; }
flush_all() { local now file bucket partial failed=0; now=$(date -u +%s); for file in "$state"/agg-*.json; do [[ -f $file ]] || continue; bucket=$(jq -er '.bucket' "$file") || { log "invalid aggregate state"; failed=1; continue; }; partial=false; (( bucket + window > now )) && partial=true; flush_file "$file" "$partial" || failed=1; done; return "$failed"; }
flush_progress() { local file bucket failed=0; for file in "$state"/agg-*.json; do [[ -f $file ]] || continue; bucket=$(jq -er '.bucket' "$file") || { failed=1; continue; }; if (( bucket < latest_bucket )); then flush_file "$file" false || failed=1; fi; done; return "$failed"; }
record_event() {
local event=$1 cursor=$2 ts epoch bucket start end rule key host severity description source file
rule=$(jq -er '.rule | strings | select(length > 0) | gsub("[\\r\\n]"; " ") | .[0:64]' <<<"$event") || return 1
ts=$(jq -r '.ts // empty' <<<"$event"); epoch=$(date -u -d "$ts" +%s 2>/dev/null) || { log "invalid timestamp for rule $rule; cursor not advanced"; return 1; }
bucket=$(( epoch / window * window )); (( bucket > latest_bucket )) && latest_bucket=$bucket; start=$(date -u -d "@$bucket" '+%Y-%m-%dT%H:%M:%SZ') || return 1; end=$(date -u -d "@$((bucket + window))" '+%Y-%m-%dT%H:%M:%SZ') || return 1
host=$(jq -r '(.host // "unknown") | tostring | gsub("[\\r\\n]"; " ") | .[0:128]' <<<"$event")
severity=$(jq -r '(.severity // "notice") | tostring | gsub("[\\r\\n]"; " ") | .[0:32]' <<<"$event")
  case $severity in debug|info|notice|warning|error|critical) ;; *) severity=notice ;; esac
description=$(jq -r '(.description // "") | tostring | gsub("[\\r\\n]"; " ") | .[0:160]' <<<"$event")
source=$(jq -r '(.fields.src // .fields.source // .threshold.group // "") | tostring | gsub("[\\r\\n]"; " ") | .[0:128]' <<<"$event")
key=$(printf '%s' "$rule" | sha256sum | cut -c1-16); file=$state/agg-"$bucket"-"$key".json
if [[ ! -f $file ]]; then
if (( $(pending_count) >= max_pending )); then flush_due || true; (( $(pending_count) < max_pending )) || { log "pending summary limit reached; stopping before cursor advance"; return 2; }; fi
jq -cn --argjson bucket "$bucket" --arg start "$start" --arg end "$end" --arg host "$host" --arg rule "$rule" --arg severity "$severity" --arg description "$description" --arg source "$source" --arg cursor "$cursor" '{bucket:$bucket,window_start:$start,window_end:$end,host:$host,rule:$rule,severity:$severity,description:$description,source:$source,source_seen:true,count:1,last_cursor:$cursor}' > "$file.tmp.$$" || return 1
mv -f "$file.tmp.$$" "$file" || return 1
else
if jq -e --arg cursor "$cursor" '.last_cursor == $cursor' "$file" >/dev/null; then save_cursor "$cursor" || return 1; return 0; fi
jq --arg cursor "$cursor" --arg host "$host" --arg source "$source" '.count += 1 | .last_cursor=$cursor | .host=(if .host == $host then .host else "multiple" end) | .source=(if .source_seen then (if .source == $source then .source else "multiple" end) else $source end) | .source_seen=true' "$file" > "$file.tmp.$$" || return 1
mv -f "$file.tmp.$$" "$file" || return 1
fi
save_cursor "$cursor"
}
process_entry() { local entry=$1 cursor event; cursor=$(jq -er '.__CURSOR | strings | select(length > 0)' <<<"$entry") || return 0; event=$(jq -r '.MESSAGE | strings' <<<"$entry"); if [[ $event == "{"* ]] && jq -e '.v == 1 and (.rule | type == "string") and (.ts | type == "string")' >/dev/null 2>&1 <<<"$event"; then record_event "$event" "$cursor"; else save_cursor "$cursor"; fi; }
if [[ -s $cursor_file ]]; then from="--after-cursor=$(cat "$cursor_file")"; else from=--lines=0; fi
# shellcheck disable=SC2329 # invoked by the trap below
shutdown() { if flush_all; then exit 0; else exit 1; fi; }
trap shutdown TERM INT
journalctl --namespace=logwizz -u logwizz -p "$min" -f -o json "$from" | {
# On a read timeout bash keeps the partial line it has read so far in $entry:
# carry it over so a line split across the timeout is not lost or misparsed.
pending_line=
while true; do entry=; IFS= read -r -t 1 entry; rc=$?
if (( rc == 0 )); then entry=$pending_line$entry; pending_line=; process_entry "$entry" || { log "could not persist event; stopping before cursor advance"; break; }; flush_progress || true
elif (( rc > 128 )); then pending_line+=$entry; flush_due || true; continue
else entry=$pending_line$entry; if [[ -n $entry ]]; then process_entry "$entry" || log "could not persist event; stopping before cursor advance"; fi; break; fi; done
flush_all || true
log "journalctl exited; systemd will restart the notifier"
exit 1
}
