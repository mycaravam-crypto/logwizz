# /etc/logwizz/fail2ban-bridge.env: settings for logwizz-fail2ban-bridge.service.
# Invalid values stop the bridge (it fails closed); see `journalctl -u logwizz-fail2ban-bridge`.

# Rules whose events may lead to a ban (default below). The bridge writes a
# line only for these, with a globally routable source address. Leave out
# rules that can report your own traffic (ssh_login, login_after_scan) and
# network rules (subnet_scan: only its last address would be banned).
#BRIDGE_RULES=port_scan,fast_scan,slow_scan,tcp_flag_scan,ssh_bruteforce,ssh_probe,scanner_user_agent

# Addresses and networks never written, e.g. management networks and your
# own scanners. Fail2ban's ignoreip and ignoreself still apply as well.
#BRIDGE_IGNORE=192.0.2.10,198.51.100.0/24,2001:db8::/32

# 1: log each line the bridge would write to its journal, write nothing.
# Start with this and watch `journalctl -u logwizz-fail2ban-bridge -f`.
BRIDGE_DRY_RUN=1
