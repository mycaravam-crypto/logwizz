# Copy to /etc/fail2ban/jail.d/logwizz.local and review before enabling.
[logwizz]
enabled  = false
filter   = logwizz
logpath  = /var/log/logwizz/fail2ban.log
backend  = auto
usedns   = no
maxretry = 1
findtime = 600
bantime  = 3600

# Optional actionban reporting to logwizz-notify (requires the
# packaging/fail2ban/action.d/logwizz-report.py file to be installed).
# Firewall action must be listed first. A report indicates an actionban
# callback, not independently verified firewall enforcement.
# action = %(action_)s
#          logwizz-report.py
