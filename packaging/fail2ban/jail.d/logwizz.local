# Copy to /etc/fail2ban/jail.d/logwizz.local and review before enabling.
[logwizz]
enabled  = false
filter   = logwizz
logpath  = /var/log/logwizz/fail2ban.log
backend  = auto
usedns   = no
maxretry = 1
findtime = 600
bantime  = 3600

# Optional actionban reporting to logwizz-notify (requires the
# packaging/fail2ban/action.d/logwizz-report.py file to be installed).
# Only the stock nftables-multiport backend is verified; other backends
# fail closed. The action queries set membership and a linked input drop rule
# before reporting. Keep the real firewall action first.
# banaction = nftables-multiport
# action = %(action_)s
#          logwizz-report.py
